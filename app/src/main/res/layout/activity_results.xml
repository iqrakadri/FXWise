<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="22dp"
        android:paddingEnd="18dp"
        android:paddingBottom="38dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="78dp"
                android:layout_height="40dp"
                android:backgroundTint="#17213A"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#BFD2F7"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="FXWise"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Your transfer options"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_variable" />

        <TextView
            android:id="@+id/tvRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="United States to India"
            android:textColor="#AEB8D0"
            android:textSize="13sp"
            android:fontFamily="@font/inter_variable" />


        <!-- PRIORITY INSIGHT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_result_info"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR PRIORITY"
                android:textColor="#6FA3FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvPriority"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Lowest overall cost"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvWhy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Comparison is focused on total known transfer cost."
                android:textColor="#9AA8C2"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvBestMatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="Best match: Provider A"
                android:textColor="#6FA3FF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

        </LinearLayout>


        <!-- HERO SUMMARY -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_result_hero"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RECIPIENT RECEIVES"
                android:textColor="#C9D9FF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
