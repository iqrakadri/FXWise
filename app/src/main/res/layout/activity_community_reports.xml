<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="16dp"
            android:paddingEnd="22dp"
            android:paddingBottom="40dp">

            <!-- HEADER -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnBack"
                    android:layout_width="58dp"
                    android:layout_height="38dp"
                    android:backgroundTint="#151F35"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="Back"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="FXWise"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="58dp"
                    android:layout_height="38dp" />

            </LinearLayout>


            <!-- INTRO -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="38dp"
                android:letterSpacing="0.18"
                android:text="COMMUNITY DATA"
                android:textColor="#6FA5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="serif"
                android:text="What people&#10;actually received."
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:textStyle="normal"
                android:lineSpacingExtra="-3dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Real transfer experiences from the FXWise community."
                android:textColor="#98A6BE"
                android:textSize="15sp"
                android:lineSpacingExtra="3dp" />


            <!-- ROUTE -->

            <TextView
                android:id="@+id/tvRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="Choose your transfer route"
                android:textColor="#DCE5F5"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- COUNTRY SELECTORS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal"
                android:weightSum="2">

                <Button
                    android:id="@+id/btnFromCountry"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#B8D8F0"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="From country"
                    android:textAllCaps="false"
                    android:textColor="#17213A"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/btnToCountry"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:backgroundTint="#B8D8F0"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text="To country"
                    android:textAllCaps="false"
                    android:textColor="#17213A"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- CURRENCIES -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2">

                <TextView
                    android:id="@+id/tvFromCurrency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:text="Sending currency"
                    android:textColor="#6F7F99"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvToCurrency"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:text="Receiving currency"
                    android:textColor="#6F7F99"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- PROVIDER -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Provider"
                android:textColor="#9AA9C1"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerProvider"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="7dp"
                android:background="@drawable/bg_spinner_dark"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:spinnerMode="dropdown" />


            <!-- ACTION -->

            <Button
                android:id="@+id/btnLoadReports"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#4D8DFF"
                android:minHeight="0dp"
                android:text="View community data"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- COMMUNITY SNAPSHOT -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:letterSpacing="0.14"
                android:text="COMMUNITY SNAPSHOT"
                android:textColor="#71809A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReportCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="48sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="reports"
                    android:textColor="#8E9CB4"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- METRICS -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAverageDifference"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Average difference"
                        android:textColor="#71809A"
                        android:textSize="11sp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAverageExtraFee"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Average extra fee"
                        android:textColor="#71809A"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- EVIDENCE -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEvidenceCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvEvidencePercentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="0% with evidence"
                    android:textColor="#94A3BA"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvDataConfidence"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Select a route to view community data."
                android:textColor="#687791"
                android:textSize="11sp" />


            <!-- RECENT REPORTS -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:letterSpacing="0.14"
                android:text="RECENT REPORTS"
                android:textColor="#71809A"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmptyReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="No community reports found for this route."
                android:textColor="#9AA8BE"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/reportsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />


            <!-- DISCLAIMER -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:gravity="center"
                android:text="Community reports are user-submitted and may differ from final provider quotes."
                android:textColor="#59677E"
                android:textSize="10sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>