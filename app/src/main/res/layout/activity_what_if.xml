<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnBackWhatIf"
                android:layout_width="78dp"
                android:layout_height="40dp"
                android:backgroundTint="#17213A"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="Back"
                android:textAllCaps="false"
                android:textColor="#D7D9F5"
                android:textSize="12sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="FXWise"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

        </LinearLayout>


        <!-- TITLE -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="What if?"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_variable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Explore how your transfer decision changes."
            android:textColor="#AAB6CC"
            android:textSize="13sp"
            android:fontFamily="@font/inter_variable" />


        <!-- ROUTE CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#11182B"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CURRENT TRANSFER"
                android:textColor="#8EAFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvWhatIfRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="United Arab Emirates to India"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvWhatIfCurrencyRoute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="AED to INR"
                android:textColor="#9DAAC2"
                android:textSize="12sp"
                android:fontFamily="@font/inter_variable" />

        </LinearLayout>


        <!-- TRANSFER AMOUNT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_what_if_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TRANSFER AMOUNT"
                android:textColor="#8EAFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvWhatIfAmountLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="AED 1,000.00"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Adjust the amount to explore different outcomes."
                android:textColor="#8D99B0"
                android:textSize="11sp"
                android:fontFamily="@font/inter_variable" />

            <SeekBar
                android:id="@+id/seekAmount"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:max="4500"
                android:progress="900" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="100"
                    android:textColor="#74809A"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_variable" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5,000"
                    android:textColor="#74809A"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_variable" />

            </LinearLayout>

        </LinearLayout>


        <!-- PRIORITY -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="WHAT MATTERS MOST?"
            android:textColor="#8EAFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_variable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Your priority changes which provider FXWise recommends."
            android:textColor="#7F8CA5"
            android:textSize="11sp"
            android:fontFamily="@font/inter_variable" />


        <!-- IMPORTANT:
             RadioButtons are DIRECT children of RadioGroup.
             This makes them mutually exclusive. -->

        <RadioGroup
            android:id="@+id/priorityGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbBalanced"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_priority_option"
                android:buttonTint="#6E9FEF"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:text="Balanced"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <RadioButton
                android:id="@+id/rbLowestCost"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_priority_option"
                android:buttonTint="#6E9FEF"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:text="Lowest overall cost"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <RadioButton
                android:id="@+id/rbFastest"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_priority_option"
                android:buttonTint="#6E9FEF"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:text="Fastest"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <RadioButton
                android:id="@+id/rbMostReceived"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:background="@drawable/bg_priority_option"
                android:buttonTint="#6E9FEF"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="12dp"
                android:text="Most money received"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

        </RadioGroup>


        <!-- RESULT -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_what_if_result"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR BEST OPTION"
                android:textColor="#AEBBFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvScenarioVerdict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Wise"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvScenarioReason"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Best overall balance for this scenario."
                android:textColor="#B8C2D8"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="@font/inter_variable" />


            <!-- RECIPIENT + COST -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="#263A5C"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="RECIPIENT GETS"
                        android:textColor="#8998B4"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_variable" />

                    <TextView
                        android:id="@+id/tvScenarioReceive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="INR 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_variable" />

                </LinearLayout>


                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="#263A5C"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="TOTAL COST"
                        android:textColor="#8998B4"
                        android:textSize="8sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_variable" />

                    <TextView
                        android:id="@+id/tvScenarioCost"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="AED 0.00"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/inter_variable" />

                </LinearLayout>

            </LinearLayout>


            <!-- SPEED -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#263A5C"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DELIVERY"
                    android:textColor="#8998B4"
                    android:textSize="8sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_variable" />

                <TextView
                    android:id="@+id/tvScenarioSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="1 day"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_variable" />

            </LinearLayout>


            <!-- DECISION INSIGHT -->

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="#40516F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="17dp"
                android:text="DECISION INSIGHT"
                android:textColor="#AEBBFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvDecisionInsight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="FXWise selected this option based on your current priority."
                android:textColor="#D5DCEB"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:id="@+id/tvScenarioNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Scenario estimate only. Provider quotes may differ."
                android:textColor="#74809A"
                android:textSize="9sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/inter_variable" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>