<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="22dp"
        android:paddingEnd="22dp"
        android:paddingBottom="40dp">

        <!-- Top bar -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FXWise"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_variable" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Smarter Transfers. Lower Costs."
                    android:textColor="#8997B5"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_variable" />

            </LinearLayout>

            <Button
                android:layout_width="110dp"
                android:layout_height="40dp"
                android:backgroundTint="#17213A"
                android:fontFamily="@font/inter_variable"
                android:minWidth="90dp"
                android:minHeight="90dp"
                android:text="Profile"
                android:textAllCaps="false"
                android:textColor="#BFD2F7"
                android:textSize="13dp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Main heading -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="42dp"
            android:text="Make every\ntransfer count."
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_variable" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:text="Compare the real cost of sending money before you choose a provider."
            android:textColor="#9AA8C2"
            android:textSize="14sp"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/inter_variable" />


        <!-- Main comparison card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_home_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSFER COMPARISON"
                android:textColor="#C9DBFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Find what your recipient actually gets."
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Fees, FX impact, speed and possible additional charges in one comparison."
                android:textColor="#D4E1F8"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/inter_variable" />

            <Button
                android:id="@+id/btnCompare"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="22dp"
                android:backgroundTint="#4D8DFF"
                android:minHeight="0dp"
                android:text="Start comparison"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <Button
                android:id="@+id/btnActualPromised"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#D5E9F7"
                android:fontFamily="@font/inter_variable"
                android:text="Actual vs Promised"
                android:textColor="#17213A"
                android:textSize="15sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- Quick actions -->
        <Button
            android:id="@+id/btnCommunityReports"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#1B2942"
            android:text="Community Reports"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Quick access"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/inter_variable" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">


            <!-- Rates -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="#11182B"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rates"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_variable" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Reference FX rates"
                    android:textColor="#8997B5"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_variable" />

            </LinearLayout>


            <!-- What-if -->

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="#11182B"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="What-if"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/inter_variable" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Explore different amounts"
                    android:textColor="#8997B5"
                    android:textSize="10sp"
                    android:fontFamily="@font/inter_variable" />

            </LinearLayout>

        </LinearLayout>


        <!-- Transparency section -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#11182B"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TRANSPARENCY FIRST"
                android:textColor="#6FA3FF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="See beyond the advertised transfer fee."
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="@font/inter_variable" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="FXWise separates transfer fees, FX impact and potential additional charges so you can understand the true transfer cost."
                android:textColor="#8997B5"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/inter_variable" />

        </LinearLayout>


        <!-- Bottom note -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="FXWise provides comparison information and does not execute money transfers."
            android:textColor="#66738D"
            android:textSize="9sp"
            android:fontFamily="@font/inter_variable" />

    </LinearLayout>

</ScrollView>