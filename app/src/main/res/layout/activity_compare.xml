<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">

    <!-- ================================================= -->
    <!-- SCROLLABLE CONTENT -->
    <!-- ================================================= -->

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0B1020"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="82dp"
            android:paddingEnd="22dp"
            android:paddingBottom="36dp">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter_variable"
                android:text="Compare transfers"
                android:textColor="#FFFFFF"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/inter_variable"
                android:text="See what you could actually pay and receive."
                android:textColor="#9AA8C2"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- ROUTE CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_compare_card_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="TRANSFER ROUTE"
                    android:textColor="#6FA3FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />


                <!-- Sending Country -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="Sending from"
                    android:textColor="#8997B5"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/tvFromCountry"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_select_field_sky"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Select sending country"
                    android:textAllCaps="false"
                    android:textColor="#17213A"
                    android:textSize="14sp" />


                <!-- Receiving Country -->

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="17dp"
                    android:fontFamily="@font/inter_variable"
                    android:text="Sending to"
                    android:textColor="#8997B5"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/tvToCountry"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/bg_select_field_sky"
                    android:backgroundTint="@null"
                    android:fontFamily="@font/inter_variable"
                    android:gravity="center_vertical|start"
                    android:minHeight="0dp"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Select receiving country"
                    android:textAllCaps="false"
                    android:textColor="#17213A"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- AMOUNT CARD -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_compare_card_dark"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_variable"
                    android:text="AMOUNT TO SEND"
                    android:textColor="#6FA3FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_amount_field_dark"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp">

                    <TextView
                        android:id="@+id/tvCurrency"
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_variable"
                        android:text="USD"
                        android:textColor="#78A8FF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/etAmount"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@android:color/transparent"
                        android:fontFamily="@font/inter_variable"
                        android:hint="500"
                        android:inputType="numberDecimal"
                        android:paddingStart="8dp"
                        android:paddingEnd="0dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#52617C"
                        android:textSize="25sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PRIORITY -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:fontFamily="@font/inter_variable"
                android:text="YOUR PRIORITY"
                android:textColor="#6FA3FF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/priorityGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_compare_card_dark"
                android:orientation="vertical"
                android:paddingStart="10dp"
                android:paddingTop="7dp"
                android:paddingEnd="10dp"
                android:paddingBottom="7dp">

                <RadioButton
                    android:id="@+id/rbLowestCost"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:buttonTint="#5B97FF"
                    android:fontFamily="@font/inter_variable"
                    android:text="Lowest overall cost"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbFastest"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:buttonTint="#5B97FF"
                    android:fontFamily="@font/inter_variable"
                    android:text="Fastest transfer"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbMostReceived"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:buttonTint="#5B97FF"
                    android:fontFamily="@font/inter_variable"
                    android:text="Most money received"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rbBalanced"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:buttonTint="#5B97FF"
                    android:fontFamily="@font/inter_variable"
                    android:text="Balanced"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp" />

            </RadioGroup>


            <!-- ================================================= -->
            <!-- MAIN CTA -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnFindOptions"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#4D8DFF"
                android:fontFamily="@font/inter_variable"
                android:minHeight="0dp"
                android:text="Compare transfer options"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />


            <!-- ================================================= -->
            <!-- DISCLAIMER -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:fontFamily="@font/inter_variable"
                android:text="Informational comparison only. FXWise does not execute transfers."
                android:textColor="#66738D"
                android:textSize="10sp" />

        </LinearLayout>

    </ScrollView>


    <!-- ================================================= -->
    <!-- FIXED TOP BAR -->
    <!-- Stays visible while scrolling -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="#0B1020"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingEnd="22dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="78dp"
            android:layout_height="40dp"
            android:backgroundTint="#17213A"
            android:fontFamily="@font/inter_variable"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#BFD2F7"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter_variable"
            android:gravity="end|center_vertical"
            android:text="FXWise"
            android:textColor="#6FA3FF"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</FrameLayout>