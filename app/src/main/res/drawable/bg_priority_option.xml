<?xml version="1.0" encoding="utf-8"?>

<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_checked="true">

        <shape>

            <solid android:color="#263A5C" />

            <corners android:radius="16dp" />

            <stroke
                android:width="2dp"
                android:color="#6E9FEF" />

            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp" />

        </shape>

    </item>

    <item>

        <shape>

            <solid android:color="#1B2942" />

            <corners android:radius="16dp" />

            <stroke
                android:width="1dp"
                android:color="#263A5C" />

            <padding
                android:left="4dp"
                android:top="4dp"
                android:right="4dp"
                android:bottom="4dp" />

        </shape>

    </item>

</selector>